# Copy to .env and fill in. .env is gitignored — never commit real values.

# Vast.ai API key — get yours at https://cloud.vast.ai/manage-keys/
# VAST_API_KEY=

# Worker image registry/repo (default: ghcr.io/bigpick/vast-ai-hashcat-helpers)
# REMOTE_HASHCAT_REGISTRY=ghcr.io/bigpick/vast-ai-hashcat-helpers

# Worker CUDA version — must stay <= 13.0 (default: 12.9.1)
# REMOTE_HASHCAT_CUDA=12.9.1

# Pinned hashcat tag baked into the image (default: v7.1.2)
# REMOTE_HASHCAT_HASHCAT_VERSION=v7.1.2

# SSH public key registered with Vast for instance access.
# The matching private key is used to connect. (default: ~/.ssh/id_ed25519.pub)
# REMOTE_HASHCAT_SSH_KEY=~/.ssh/id_ed25519.pub

# Label applied to provisioned instances (default: remote-hashcat)
# REMOTE_HASHCAT_LABEL=remote-hashcat

# Fleet registry location (default: ~/.config/remote-hashcat)
# REMOTE_HASHCAT_CONFIG_DIR=~/.config/remote-hashcat
